doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    title Todo List
  body
    .container.mt-5
      h1.mb-4 Todo List
      .row.mb-3
        .col-9
          input.form-control#todo(type="text" placeholder="Enter a todo")
        .col-3
          button.btn.btn-primary.w-100(onclick="handleSubmit()") Add
      each todo in todos
        .form-check.mb-2
          input.form-check-input(
            type="checkbox"
            checked=todo.done
            onchange="handleCheck(this)"
            data-id=todo._id
          )
          label.form-check-label= todo.todo
    script(src="/main.js")

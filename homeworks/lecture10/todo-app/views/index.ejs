<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title>Todo List App</title>
</head>
<body>
  <h1>Todo List</h1>

  <form action="/todos" method="POST">
    <input type="text" name="title" placeholder="Enter a new todo" required>
    <button type="submit">Add Todo</button>
  </form>
  <p><strong><%= remainingCount %></strong> task(s) remaining</p>
  <h2>Tasks</h2>
  <ul>
    <% todos.forEach(todo => { %>
      <li>
        <span style="<%= todo.completed ? 'text-decoration: line-through;' : '' %>">
          <%= todo.title %>
        </span>
        <form action="/todos/<%= todo._id %>/update" method="POST" style="display:inline;">
          <button type="submit">
            <%= todo.completed ? 'Mark as Pending' : 'Mark as Completed' %>
          </button>
        </form>
        <form action="/todos/<%= todo._id %>/delete" method="POST" style="display:inline;">
          <button type="submit">Delete</button>
        </form>
      </li>
    <% }); %>
  </ul>
</body>
</html>

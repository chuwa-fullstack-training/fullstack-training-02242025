doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(
      rel="stylesheet",
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM"
      crossorigin="anonymous")
    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz"
      crossorigin="anonymous")
    title Todo List 
  body
    .container.mt-5
      h1.mb-4.text-center Todo List

      
      form(action="/" method="POST" class="row g-3 mb-4")
        .col-9
          input(name="title" id="title" class="form-control" placeholder="Enter todo" required)
        .col-3
          button(class="btn btn-primary w-100") Add Todo

      each todo in todos
        .row.align-items-center.mb-2
          .col-1
            form(action="/toggle/" + todo._id method="POST")
              button.btn.btn-sm(class=todo.completed ? "btn-success" : "btn-outline-secondary") #{todo.completed ? "✅" : "⬜️"}
          .col-9
            span(class=todo.completed ? "text-decoration-line-through text-muted" : "") #{todo.title}
          .col-2
            form(action="/delete/" + todo._id method="POST")
              button.btn.btn-danger.btn-sm(type="submit") ❌

